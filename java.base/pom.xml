<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.cprover.models</groupId>
    <artifactId>models</artifactId>
    <version>1.0-SNAPSHOT</version>
  </parent>

  <artifactId>java.base</artifactId>
  <packaging>jar</packaging>

  <name>CProver JDK Models - java.base</name>

  <!-- Tell javadoc plugin not to fail on warnings -->
  <profiles>
    <profile>
      <id>java8-doclint-disabled</id>
      <activation>
        <jdk>[1.8,)</jdk>
      </activation>
      <properties>
        <javadoc.opts>-Xdoclint:none</javadoc.opts>
      </properties>
    </profile>
  </profiles>

  <dependencies>
    <dependency>
      <groupId>org.cprover.util</groupId>
      <artifactId>cprover-api</artifactId>
      <version>1.0.0</version>
      <scope>compile</scope>
    </dependency>
  </dependencies>

  <build>
    <!--
      This is the only module, so build straight into the top-level
      target/ directory: other build systems (jbmc/CMakeLists.txt,
      jbmc/src/Makefile) expect core-models.jar and cprover-api.jar at
      java-models-library/target/, not java-models-library/java.base/target/.
    -->
    <directory>${project.basedir}/../target</directory>
    <finalName>core-models</finalName>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <release>21</release>
          <!--
            These sources replace/extend the java.base module itself, so
            they must be compiled as a patch to java.base rather than as
            ordinary classpath sources (javac otherwise rejects user code
            in java.*/javax.*/jdk.* packages with "package exists in
            another module").
          -->
          <compilerArgs>
            <arg>--patch-module</arg>
            <arg>java.base=${project.basedir}/src/main/java</arg>
            <arg>--add-reads</arg>
            <arg>java.base=ALL-UNNAMED</arg>
          </compilerArgs>
          <excludes>
            <!-- Javadoc @snippet example sources, not meant to be compiled -->
            <exclude>**/snippet-files/**</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.6.1</version>
        <executions>
          <execution>
            <id>copy-cprover-api</id>
            <phase>package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.cprover.util</groupId>
                  <artifactId>cprover-api</artifactId>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                  <destFileName>cprover-api.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <outputDirectory>doc</outputDirectory>
          <quiet>true</quiet>
          <nosince>true</nosince>
          <sourcepath>src/main/java</sourcepath>
          <subpackages>java:javax:jdk:sun:com</subpackages>
          <windowtitle>CProver JDK Models Library</windowtitle>
          <doctitle>CProver JDK Models Library</doctitle>
          <additionalOptions>
            <additionalOption>--patch-module</additionalOption>
            <additionalOption>java.base=${project.basedir}/src/main/java</additionalOption>
            <additionalOption>--add-reads</additionalOption>
            <additionalOption>java.base=ALL-UNNAMED</additionalOption>
          </additionalOptions>
          <tags>
            <tag>
              <name>cprover.fullSupport</name>
              <placement>ptcm</placement>
              <head>CPROVER: Full support</head>
            </tag>
            <tag>
              <name>cprover.limitedSupport</name>
              <placement>ptcm</placement>
              <head>CPROVER: Limited support</head>
            </tag>
            <tag>
              <name>cprover.noSupport</name>
              <placement>ptcm</placement>
              <head>CPROVER: No support</head>
            </tag>
            <tag>
              <name>cprover.untested</name>
              <placement>ptcm</placement>
              <head>CPROVER: Untested</head>
            </tag>
            <tag>
              <name>cprover.todo</name>
              <placement>ptcm</placement>
              <head>CPROVER: To do</head>
            </tag>
          </tags>
          <!-- No fail on warning -->
          <additionalparam>${javadoc.opts}</additionalparam>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
